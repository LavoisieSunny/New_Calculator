# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# The network interface host address to bind the FastAPI/Uvicorn server to.
# Default: 0.0.0.0 (binds to all interfaces)
COMP_CALC_HOST=0.0.0.0

# The network port to run the server on.
# Default: 7203
COMP_CALC_PORT=7203

# Run the server in debug mode (enables reload/detailed traceback).
# Default: True
COMP_CALC_DEBUG=True


# ==============================================================================
# LLM SERVICE & ENDPOINT CONFIGURATION
# ==============================================================================
# The LLM provider backend to use. Options include: 'ollama', 'openai', etc.
# Default: ollama
LLM_PROVIDER=ollama

# The primary model name used for general extraction, rewriting, and inference.
# Default: qwen2.5:14b
LLM_MODEL_NAME=qwen2.5:14b

# The API key required by the LLM provider (not needed for local Ollama).
# Default: empty
LLM_API_KEY=

# The host URL / api endpoint of the LLM provider service.
# Default: http://localhost:11434 (standard local Ollama endpoint)
LLM_API_ENDPOINT=http://localhost:11434

# General temperature setting for LLM responses (0.0 for deterministic).
# Default: 0.0
LLM_SUMMARY_TEMPERATURE=0.0

# Shared concurrency gate constraints for Ollama.
# Maximum concurrent requests allowed per unique model name.
# Default: 3
OLLAMA_MODEL_MAX_CONCURRENT=3

# Maximum concurrent requests allowed for embedding generation.
# Default: 2
OLLAMA_EMBED_MAX_CONCURRENT=2


# ==============================================================================
# MULTI-STAGE LLM CONFIGURATION (SPECIFIC CHANNELS)
# ==============================================================================
# --- Translation Model Settings ---
# Default model to use for translations. Defaults to LLM_MODEL_NAME if empty.
# Default: qwen2.5:14b
LLM_TRANSLATION_MODEL_NAME=qwen2.5:14b
# Default: 0.0
LLM_TRANSLATION_TEMPERATURE=0.0

# --- Claim Extraction Model Settings ---
# Default model to use for claim detail extraction. Defaults to LLM_MODEL_NAME if empty.
# Default: qwen2.5:14b
LLM_CLAIM_EXTRACTION_MODEL_NAME=qwen2.5:14b
# Default: 0.0
LLM_CLAIM_EXTRACTION_TEMPERATURE=0.0

# --- Final Summary Model Settings ---
# Default model to use for generating the final legal summary (typically deepseek-r1).
# Default: deepseek-r1:14b
LLM_FINAL_SUMMARY_MODEL_NAME=deepseek-r1:14b
# Default: 0.0
LLM_FINAL_SUMMARY_TEMPERATURE=0.0

# --- Grounding Settings ---
# Enable log verbose details for RAG/precedent grounding failures.
# Default: false
LOG_VERBOSE_GROUNDING_FAILURES=false


# ==============================================================================
# OCR PIPELINE PARAMETERS & GATING
# ==============================================================================
# Target DPI for rendering PDF pages to image paths for the OCR engine.
# Default: 150 (optimal tradeoff between speed and qwen2.5vl vision recognition)
OCR_RENDER_DPI=150

# Fallback/retry DPI utilized when initial OCR quality drops below threshold limits.
# Default: 200
OCR_RETRY_DPI=200

# Number of parallel workers used for rendering page bitmaps.
# Default: 4
OCR_MAX_PARALLEL_WORKERS=4

# Overall page-processing worker pool size.
# Default: min(16, max(4, CPU_COUNT * 2))
# OCR_PAGE_WORKER_POOL_SIZE=8

# Timeout duration limit in seconds for a single page OCR run.
# Default: 60.0
OCR_PAGE_TIMEOUT=60.0

# Model name of the local vision model used for OCR escalations.
# Default: qwen2.5vl:7b
OCR_VISION_MODEL=qwen2.5vl:7b

# Enable/disable debug dumps of OCR images.
# Default: false
DEBUG_OCR=false

# Device layout configuration parameter for PaddleOCR.
# Default: gpu:0 (falls back to cpu if GPU is unavailable)
OCR_DEVICE=gpu:0

# Language to configure for the PP-OCRv5 model engine.
# Default: hi (covers both Hindi Devanagari and English characters)
OCR_PADDLE_LANG=hi

# Average line confidence score threshold below which PaddleOCR output is untrusted.
# Default: 0.85
OCR_PADDLE_CONF_THRESHOLD=0.85

# Minimum heuristic quality score below which PaddleOCR output is escalated.
# Default: 0.40
OCR_PADDLE_QUALITY_THRESHOLD=0.40

# Enable/disable escalating low-quality pages to the vision model.
# Default: true
OCR_ENABLE_VISION_ESCALATION=true

# Soft soft warning limit in MB for process RSS.
# Default: 3000
OCR_MEMORY_WARN_MB=3000

# Max time in seconds for worker threads to pause waiting for memory headroom.
# Default: 20.0
OCR_MEMORY_GATE_MAX_WAIT=20.0

# Hard cap on the maximum number of pages allowed to hold image buffers in memory concurrently.
# Default: 3
OCR_MAX_PAGES_IN_FLIGHT=3

# Enable/disable PP-StructureV3 layout analysis and table-structure extraction.
# Default: true
OCR_ENABLE_TABLE_STRUCTURE=true


# ==============================================================================
# OCR HANDWRITING DETECTION CONFIGURATION (METADATA-CRITICAL PAGES)
# ==============================================================================
# Number of leading pages (0-indexed page_idx < N) treated as metadata-critical
# (typically covers cause title, case details, computer sheet).
# Default: 3
OCR_HANDWRITING_CHECK_PAGES=3

# Stricter confidence bar for handwriting checks on metadata-critical pages.
# Default: 0.90
OCR_HANDWRITING_CONF_THRESHOLD=0.90

# Stricter quality bar for handwriting checks on metadata-critical pages.
# Default: 0.50
OCR_HANDWRITING_QUALITY_THRESHOLD=0.50


# ==============================================================================
# DYNAMIC ROUTING & HEADING SCAN PARAMETERS
# ==============================================================================
# Target DPI for rendering pages when scanning for heading keywords in lower courts.
# Default: 110
OCR_HEADING_SCAN_DPI=110

# Max number of pages from the beginning of the PDF to scan for relevant headers.
# Default: 80
OCR_HEADING_SCAN_MAX_PAGES=80

# Wider index boundary limit when widening the search range for headings.
# Default: 150
OCR_HEADING_SCAN_WIDEN_MAX_PAGES=150


# ==============================================================================
# VECTOR DATABASE CONFIGURATION
# ==============================================================================
# The address connection URL of the Qdrant service.
# Default: http://localhost:7204
QDRANT_URL=http://localhost:7204
